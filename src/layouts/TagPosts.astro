---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Card from '../components/Card.astro';
import type { Post } from '../utils/content';

export interface Props {
  posts: Post[];
  tag: string;
  tagCount: number;
}

const { posts, tag, tagCount } = Astro.props;
---

<BaseLayout title={`Tag: #${tag} | Joy (@le-temps)`} activeNav="tags">
  <Breadcrumbs />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    <h1 class="text-2xl font-semibold sm:text-3xl text-skin-accent">
      Tag: <span>#{tag}</span>
    </h1>
    <p class="mt-2 mb-6 italic text-sm opacity-80">
      All the articles with the tag "#{tag}" ({tagCount} {tagCount === 1 ? 'post' : 'posts'}).
    </p>
    <ul>
      {posts.map((post) => (
        <Card post={post} />
      ))}
    </ul>
  </main>
</BaseLayout>
