---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getCategoriesWithCount } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = await getCategoriesWithCount();

  return categories.map(({ category }) => {
    const filteredPosts = posts.filter((p) => p.data.category === category);
    return {
      params: { category },
      props: { posts: filteredPosts, category },
    };
  });
}

const { posts, category } = Astro.props;
---

<BaseLayout
  title={`分类：${category} | Joy (@le-temps)`}
  description={`分类 ${category} 下的全部文章`}
>
  <div class="py-12 space-y-8">
    <div class="space-y-2">
      <div class="text-xs font-semibold uppercase tracking-wider text-brand-500">分类归档 · Category</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {category}
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm">
        共有 {posts.length} 篇相关文章
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
