---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found | Joy (@le-temps)">
  <main id="main-content" class="mx-auto flex max-w-3xl flex-1 items-center justify-center">
    <div class="not-found-wrapper mb-14 flex flex-col items-center justify-center text-center">
      <h1 class="text-9xl font-bold text-skin-accent" aria-label="404 Not Found">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">Page Not Found</p>
      <a
        href="/"
        class="my-6 text-lg underline decoration-dashed underline-offset-8 text-skin-accent hover:opacity-75"
      >
        Go back home
      </a>
    </div>
  </main>
</BaseLayout>
