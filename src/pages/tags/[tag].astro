---
import TagPosts from '../../layouts/TagPosts.astro';
import { getPublishedPosts, getTagsWithCount } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getTagsWithCount();

  return tags.map(({ tag }) => {
    const tagPosts = posts.filter((p) => p.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: tagPosts, tag, tagCount: tagPosts.length },
    };
  });
}

const { posts, tag, tagCount } = Astro.props;
---

<TagPosts posts={posts} tag={tag} tagCount={tagCount} />
