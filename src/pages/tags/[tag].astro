---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTagsWithCount } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getTagsWithCount();

  return tags.map(({ tag }) => {
    const filteredPosts = posts.filter((p) => p.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts, tag },
    };
  });
}

const { posts, tag } = Astro.props;
---

<BaseLayout
  title={`标签：#${tag} | Joy (@le-temps)`}
  description={`带有 #${tag} 标签的全部文章`}
>
  <div class="py-12 space-y-8">
    <div class="space-y-2">
      <div class="text-xs font-semibold uppercase tracking-wider text-brand-500">标签归档 · Tag</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        #{tag}
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm">
        包含该标签的文章共 {posts.length} 篇
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
