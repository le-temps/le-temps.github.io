---
---

<section class="relative pt-16 pb-14 md:pt-24 md:pb-20 overflow-hidden">
  <!-- Subtle Gradient Orb -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-gradient-to-tr from-brand-500/10 via-indigo-500/10 to-purple-500/10 blur-[100px] pointer-events-none rounded-full" />

  <div class="relative max-w-4xl mx-auto text-center px-4 sm:px-6 space-y-6">
    <!-- Academic Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-semibold text-brand-600 dark:text-brand-400 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
      <span>🎓 USTC (中国科学技术大学) · AI Agent & LLM Researcher</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.15]">
      Exploring <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 via-blue-500 to-indigo-500">AI Agents</span>, Systems & Creative Engineering.
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
      你好，我是 <strong class="text-slate-900 dark:text-white">Joy (@le-temps)</strong>。这里记录我的大模型技术深度探索、AI Agent 智能体架构实践、科大实验室科研手记与开源工程沉淀。
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a
        href="/blog"
        class="px-6 py-3 rounded-2xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center gap-2"
      >
        <span>📖 阅读技术博客</span>
      </a>
      <a
        href="#projects"
        class="px-6 py-3 rounded-2xl bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-800 font-semibold text-sm transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center gap-2"
      >
        <span>🚀 探索开源项目</span>
      </a>
    </div>
  </div>
</section>
