---
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, '');
const breadcrumbList = currentUrlPath.split('/').slice(1);

if (breadcrumbList[0] === 'posts' && (!breadcrumbList[1] || isNaN(Number(breadcrumbList[1])))) {
  breadcrumbList[0] = 'Posts (Page 1)';
} else if (breadcrumbList[0] === 'posts' && breadcrumbList[1]) {
  breadcrumbList.splice(0, 2, `Posts (Page ${breadcrumbList[1]})`);
}
---

<nav class="mx-auto mt-6 mb-2 w-full max-w-3xl px-4" aria-label="breadcrumb">
  <ul class="flex items-center space-x-2 text-sm opacity-80 text-skin-base">
    <li>
      <a href="/" class="hover:text-skin-accent">Home</a>
      <span aria-hidden="true" class="opacity-60">&#187;</span>
    </li>
    {breadcrumbList.map((breadcrumb, index) =>
      index + 1 === breadcrumbList.length ? (
        <li>
          <span class="capitalize active opacity-70" aria-current="page">
            {decodeURIComponent(breadcrumb)}
          </span>
        </li>
      ) : (
        <li>
          <a href={`/${breadcrumb}/`} class="capitalize hover:text-skin-accent">
            {decodeURIComponent(breadcrumb)}
          </a>
          <span aria-hidden="true" class="opacity-60">&#187;</span>
        </li>
      )
    )}
  </ul>
</nav>
