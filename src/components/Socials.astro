---
export interface SocialLink {
  name: string;
  href: string;
  linkTitle: string;
  icon: string;
}

const SOCIALS: SocialLink[] = [
  {
    name: 'GitHub',
    href: 'https://github.com/le-temps',
    linkTitle: 'Joy on GitHub',
    icon: 'github',
  },
  {
    name: 'Twitter',
    href: 'https://twitter.com',
    linkTitle: 'Joy on Twitter',
    icon: 'twitter',
  },
  {
    name: 'Mail',
    href: 'mailto:contact@le-temps.dev',
    linkTitle: 'Send email to Joy',
    icon: 'mail',
  },
  {
    name: 'RSS',
    href: '/rss.xml',
    linkTitle: 'RSS Feed',
    icon: 'rss',
  },
];

interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;
---

<div class={`flex flex-wrap gap-1 ${centered ? 'justify-center' : ''}`}>
  {SOCIALS.map((social) => (
    <a
      href={social.href}
      target="_blank"
      rel="noopener noreferrer"
      class="p-2 hover:rotate-6 sm:p-1 text-skin-base hover:text-skin-accent transition-transform duration-200"
      title={social.linkTitle}
    >
      {social.icon === 'github' && (
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 stroke-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
        </svg>
      )}
      {social.icon === 'twitter' && (
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 stroke-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
        </svg>
      )}
      {social.icon === 'mail' && (
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 stroke-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
      )}
      {social.icon === 'rss' && (
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 stroke-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
      )}
    </a>
  ))}
</div>
