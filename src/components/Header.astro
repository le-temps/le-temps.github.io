---
import ThemeToggle from './ThemeToggle';
import SearchModal from './SearchModal';
import MobileNav from './MobileNav';
import { getPublishedPosts } from '../utils/content';

const posts = await getPublishedPosts();
const searchItems = posts.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  date: p.data.date.toISOString().split('T')[0],
}));

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Logo / Brand -->
    <a href="/" class="flex items-center gap-2.5 text-slate-900 dark:text-white font-bold text-lg tracking-tight group">
      <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-brand-500 to-indigo-500 flex items-center justify-center text-white text-xs font-mono font-bold shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
        JOY
      </span>
      <span class="font-sans font-semibold">le-temps<span class="text-brand-500">.dev</span></span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="/" class={`hover:text-brand-500 transition-colors ${currentPath === '/' ? 'text-brand-500 font-semibold' : ''}`}>
        Home
      </a>
      <a href="/blog" class={`hover:text-brand-500 transition-colors ${currentPath.startsWith('/blog') ? 'text-brand-500 font-semibold' : ''}`}>
        Blog
      </a>
      <a href="/archive" class={`hover:text-brand-500 transition-colors ${currentPath.startsWith('/archive') ? 'text-brand-500 font-semibold' : ''}`}>
        Archive
      </a>
      <a href="/#projects" class="hover:text-brand-500 transition-colors">
        Projects
      </a>
      <a href="/about" class={`hover:text-brand-500 transition-colors ${currentPath.startsWith('/about') ? 'text-brand-500 font-semibold' : ''}`}>
        About
      </a>
    </nav>

    <!-- Right Controls: Search, Theme Toggle & Mobile Nav -->
    <div class="flex items-center gap-2 sm:gap-3">
      <SearchModal client:load items={searchItems} />
      <ThemeToggle client:load />
      <MobileNav client:load />
    </div>
  </div>
</header>
