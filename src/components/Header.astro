---
import ThemeToggle from './ThemeToggle';

export interface Props {
  activeNav?: 'posts' | 'tags' | 'about' | 'search';
}

const { activeNav } = Astro.props;
---

<header class="mx-auto max-w-3xl px-4 pt-4 sm:pt-8">
  <div class="flex items-center justify-between">
    <a
      href="/"
      class="text-xl font-semibold sm:text-2xl font-mono tracking-tight hover:text-skin-accent transition-colors py-1"
    >
      Joy (@le-temps)
    </a>

    <nav id="nav-menu" class="flex items-center space-x-2 sm:space-x-4">
      <ul id="menu-items" class="flex items-center space-x-2 sm:space-x-4 text-sm sm:text-base">
        <li>
          <a
            href="/posts"
            class={`hover:text-skin-accent ${activeNav === 'posts' ? 'text-skin-accent underline decoration-wavy decoration-2 underline-offset-4' : ''}`}
          >
            Posts
          </a>
        </li>
        <li>
          <a
            href="/tags"
            class={`hover:text-skin-accent ${activeNav === 'tags' ? 'text-skin-accent underline decoration-wavy decoration-2 underline-offset-4' : ''}`}
          >
            Tags
          </a>
        </li>
        <li>
          <a
            href="/about"
            class={`hover:text-skin-accent ${activeNav === 'about' ? 'text-skin-accent underline decoration-wavy decoration-2 underline-offset-4' : ''}`}
          >
            About
          </a>
        </li>
        <li>
          <a
            href="/search"
            class={`p-2 sm:p-1 hover:text-skin-accent focus-outline ${activeNav === 'search' ? 'text-skin-accent' : ''}`}
            aria-label="search"
            title="Search"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 stroke-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </a>
        </li>
        <li>
          <ThemeToggle client:load />
        </li>
      </ul>
    </nav>
  </div>
  <hr class="border-skin-line border-dashed my-4 sm:my-6" />
</header>
